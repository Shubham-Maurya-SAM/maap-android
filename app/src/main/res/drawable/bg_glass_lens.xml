<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inner Shadow/Depth -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20000000" />
        </shape>
    </item>

    <!-- Main Glass Body with Gradient -->
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#B0FFFFFF"
                android:centerColor="#60FFFFFF"
                android:endColor="#30FFFFFF"
                android:type="linear"
                android:angle="135" />
            <stroke
                android:width="1.5dp"
                android:color="#A0FFFFFF" />
        </shape>
    </item>

    <!-- Top Highlight/Rim -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#F0FFFFFF" />
        </shape>
    </item>
</layer-list>