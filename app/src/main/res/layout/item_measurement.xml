<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/bg_circle_brand"
            android:padding="8dp"
            android:contentDescription="Edit room name"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/blue" />

        <LinearLayout
            android:id="@+id/measurement_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_item_room_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Living Room"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/tv_item_dims"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 x 12 ft"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_item_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120.00 sq ft"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/blue" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/text_hint"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>