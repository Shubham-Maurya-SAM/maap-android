<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Measurement Screenshot -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9">
            <ImageView
                android:id="@+id/iv_measurement_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_logo_mark"
                android:contentDescription="@string/desc_app_logo"
                app:tint="#CBD5E1" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/measurement_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_item_room_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Living Room"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/tv_item_dims"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="10 x 12 ft"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_item_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="120.00 sq ft"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/blue" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="@string/btn_new_measurement"
            app:tint="@color/text_hint"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/delete_yes"
            app:tint="@color/text_hint"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>