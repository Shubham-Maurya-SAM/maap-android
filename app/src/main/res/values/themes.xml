<?xml version="1.0" encoding="utf-8"?>
<!--  res/values/themes.xml  -->
<!--  Maap brand: Deep Navy + Electric Blue  -->
<resources>
    <style name="Theme.MAAP" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!--  Primary = Electric Blue  -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1A4FBE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!--  Secondary = Navy  -->
        <item name="colorSecondary">#0F172A</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!--  Backgrounds  -->
        <item name="android:windowBackground">#F1F5F9</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <!--  Text fields use Electric Blue stroke  -->
        <item name="colorControlActivated">#2563EB</item>
    </style>

    <!--  Splash screen style — Navy bg, white logo  -->
    <style name="Theme.MAAP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MAAP</item>
    </style>
</resources>